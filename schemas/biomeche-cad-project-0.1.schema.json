{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.biomeche.invalid/cad/biomeche-cad-project-0.1.schema.json",
  "title": "BiomechE-CAD Project Manifest 0.1",
  "description": "Reference serialization envelope for the evidence-led BiomechE-CAD project schema. Semantic authority: docs/spec/02_project_schema.md.",
  "type": "object",
  "required": [
    "schemaId", "schemaVersion", "projectId", "projectCreatedAt", "projectUpdatedAt", "projectStatus",
    "patientLink", "case", "orthosisProjects", "definitions", "assets",
    "frameDefinitions", "acquisitions", "registrations", "landmarkSets", "roiDefinitions",
    "designRevisions", "outcomeTargets", "outcomeMeasurements", "outcomeComparisons",
    "promMeasurements", "comfortAssessments", "fitUsabilityAssessments", "satisfactionAssessments",
    "adherenceMeasurements", "patientExperienceBundles",
    "materialLots", "materialRegions", "materialStacks", "structuralMaterialRegions",
    "mechanicalPropertyMeasurements", "postProcessMaterialStates", "durabilityTests",
    "manufacturingRuns", "manufacturingArtifacts", "physicalOrthoses", "qcRequirements", "qcMeasurements",
    "serviceStates", "exportArtifacts", "reportArtifacts",
    "provenanceRecords", "auditEvents", "migrationHistory", "packageValidation"
  ],
  "properties": {
    "schemaId": { "const": "biomeche-cad-project" },
    "schemaVersion": { "const": "0.1" },
    "projectId": { "$ref": "#/$defs/id" },
    "projectCreatedAt": { "$ref": "#/$defs/timestamp" },
    "projectUpdatedAt": { "$ref": "#/$defs/timestamp" },
    "projectStatus": { "type": "string", "enum": ["ACTIVE", "ARCHIVED", "CLOSED", "IMPORTED", "UNKNOWN"] },
    "patientLink": { "$ref": "#/$defs/patientLink" },
    "case": { "$ref": "#/$defs/case" },
    "orthosisProjects": { "type": "array", "maxItems": 2, "items": { "$ref": "#/$defs/orthosisProject" } },
    "definitions": { "$ref": "#/$defs/projectDefinitions" },
    "assets": { "type": "array", "items": { "$ref": "#/$defs/assetDescriptor" } },
    "frameDefinitions": { "type": "array", "items": { "$ref": "#/$defs/frameDefinition" } },
    "acquisitions": { "type": "array", "items": { "$ref": "#/$defs/acquisition" } },
    "registrations": { "type": "array", "items": { "$ref": "#/$defs/registration" } },
    "landmarkSets": { "type": "array", "items": { "$ref": "#/$defs/landmarkSet" } },
    "roiDefinitions": { "type": "array", "items": { "$ref": "#/$defs/roiDefinition" } },
    "designRevisions": { "type": "array", "items": { "$ref": "#/$defs/designRevision" } },
    "outcomeTargets": { "type": "array", "items": { "$ref": "#/$defs/outcomeTarget" } },
    "outcomeMeasurements": { "type": "array", "items": { "$ref": "#/$defs/outcomeMeasurement" } },
    "outcomeComparisons": { "type": "array", "items": { "$ref": "#/$defs/outcomeComparison" } },
    "promMeasurements": { "type": "array", "items": { "$ref": "#/$defs/promMeasurement" } },
    "comfortAssessments": { "type": "array", "items": { "$ref": "#/$defs/comfortAssessment" } },
    "fitUsabilityAssessments": { "type": "array", "items": { "$ref": "#/$defs/fitUsabilityAssessment" } },
    "satisfactionAssessments": { "type": "array", "items": { "$ref": "#/$defs/satisfactionAssessment" } },
    "adherenceMeasurements": { "type": "array", "items": { "$ref": "#/$defs/adherenceMeasurement" } },
    "patientExperienceBundles": { "type": "array", "items": { "$ref": "#/$defs/patientExperienceBundle" } },
    "materialLots": { "type": "array", "items": { "$ref": "#/$defs/materialLot" } },
    "materialRegions": { "type": "array", "items": { "$ref": "#/$defs/materialRegion" } },
    "materialStacks": { "type": "array", "items": { "$ref": "#/$defs/materialStack" } },
    "structuralMaterialRegions": { "type": "array", "items": { "$ref": "#/$defs/structuralMaterialRegion" } },
    "mechanicalPropertyMeasurements": { "type": "array", "items": { "$ref": "#/$defs/mechanicalPropertyMeasurement" } },
    "postProcessMaterialStates": { "type": "array", "items": { "$ref": "#/$defs/postProcessMaterialState" } },
    "durabilityTests": { "type": "array", "items": { "$ref": "#/$defs/durabilityTest" } },
    "manufacturingRuns": { "type": "array", "items": { "$ref": "#/$defs/manufacturingRun" } },
    "manufacturingArtifacts": { "type": "array", "items": { "$ref": "#/$defs/manufacturingArtifact" } },
    "physicalOrthoses": { "type": "array", "items": { "$ref": "#/$defs/physicalOrthosis" } },
    "qcRequirements": { "type": "array", "items": { "$ref": "#/$defs/qcRequirement" } },
    "qcMeasurements": { "type": "array", "items": { "$ref": "#/$defs/qcMeasurement" } },
    "serviceStates": { "type": "array", "items": { "$ref": "#/$defs/serviceState" } },
    "exportArtifacts": { "type": "array", "items": { "$ref": "#/$defs/exportArtifact" } },
    "reportArtifacts": { "type": "array", "items": { "$ref": "#/$defs/reportArtifact" } },
    "provenanceRecords": { "type": "array", "items": { "$ref": "#/$defs/provenanceRecord" } },
    "auditEvents": { "type": "array", "items": { "$ref": "#/$defs/auditEvent" } },
    "migrationHistory": { "type": "array", "items": { "$ref": "#/$defs/migrationRecord" } },
    "packageValidation": { "$ref": "#/$defs/packageValidation" },
    "extensions": { "type": "object", "additionalProperties": true }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "description": "Opaque persistent internal ID; UUIDv7 is preferred for new IDs."
    },
    "timestamp": { "type": "string", "format": "date-time" },
    "side": { "type": "string", "enum": ["LEFT", "RIGHT"] },
    "hashValue": {
      "type": "object",
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["sha256"] },
        "value": { "type": "string", "minLength": 32 }
      },
      "additionalProperties": false
    },
    "externalIdentifier": {
      "type": "object",
      "required": ["system", "value"],
      "properties": {
        "system": { "type": "string", "minLength": 1 },
        "value": { "type": "string", "minLength": 1 },
        "type": { "type": "string" },
        "issuer": { "type": "string" }
      },
      "additionalProperties": false
    },
    "agentRef": {
      "type": "object",
      "required": ["agentType", "id"],
      "properties": {
        "agentType": { "type": "string", "enum": ["PERSON", "ORGANIZATION", "DEVICE", "SOFTWARE", "SYSTEM"] },
        "id": { "$ref": "#/$defs/id" },
        "displayName": { "type": "string" },
        "externalIdentifiers": { "type": "array", "items": { "$ref": "#/$defs/externalIdentifier" } }
      },
      "additionalProperties": false
    },
    "versionedRef": {
      "type": "object",
      "required": ["entityType", "id", "version"],
      "properties": {
        "entityType": { "type": "string", "minLength": 1 },
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 1 },
        "contentHash": { "$ref": "#/$defs/hashValue" },
        "registryUri": { "type": "string" },
        "snapshotRef": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "evidenceRef": {
      "type": "object",
      "required": ["sourceId"],
      "properties": {
        "sourceId": { "type": "string", "minLength": 1 },
        "locator": { "type": "string" },
        "claimContext": { "type": "string" }
      },
      "additionalProperties": false
    },
    "quantity": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 },
        "unitCode": { "type": "string" },
        "unitSystem": { "type": "string" },
        "comparator": { "type": "string", "enum": ["<", "<=", ">=", ">"] }
      },
      "additionalProperties": false
    },
    "algorithmRef": {
      "type": "object",
      "required": ["algorithmId", "semanticVersion"],
      "properties": {
        "algorithmId": { "type": "string", "minLength": 1 },
        "semanticVersion": { "type": "string", "minLength": 1 },
        "buildHash": { "$ref": "#/$defs/hashValue" },
        "parametersSchemaVersion": { "type": "string" }
      },
      "additionalProperties": false
    },
    "softwareBuildRef": {
      "type": "object",
      "required": ["product", "version"],
      "properties": {
        "product": { "type": "string" },
        "version": { "type": "string" },
        "commitHash": { "type": "string" },
        "buildId": { "type": "string" },
        "platform": { "type": "string" }
      },
      "additionalProperties": false
    },
    "attachedProfile": {
      "type": "object",
      "required": ["profileRef", "attachedAt", "attachedBy", "confirmationState"],
      "properties": {
        "profileRef": { "$ref": "#/$defs/versionedRef" },
        "attachedAt": { "$ref": "#/$defs/timestamp" },
        "attachedBy": { "$ref": "#/$defs/agentRef" },
        "confirmationState": { "type": "string", "enum": ["USER_CONFIRMED", "IMPORTED", "SUGGESTED_NOT_CONFIRMED"] }
      },
      "additionalProperties": false
    },
    "patientLink": {
      "type": "object",
      "required": ["projectPatientId", "externalIdentifiers", "privacyClass"],
      "properties": {
        "projectPatientId": { "$ref": "#/$defs/id" },
        "externalIdentifiers": { "type": "array", "items": { "$ref": "#/$defs/externalIdentifier" } },
        "demographicsSnapshot": { "type": "object", "additionalProperties": true },
        "privacyClass": { "type": "string", "enum": ["FULL_CLINICAL", "PSEUDONYMIZED", "MANUFACTURING_MINIMUM"] }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["caseId", "externalIdentifiers", "openedAt", "clinicianRefs", "attachedProfiles", "sourceAcquisitionIds", "notes"],
      "properties": {
        "caseId": { "$ref": "#/$defs/id" },
        "externalIdentifiers": { "type": "array", "items": { "$ref": "#/$defs/externalIdentifier" } },
        "openedAt": { "$ref": "#/$defs/timestamp" },
        "closedAt": { "$ref": "#/$defs/timestamp" },
        "clinicianRefs": { "type": "array", "items": { "$ref": "#/$defs/agentRef" } },
        "clinicalIntentText": { "type": "string" },
        "clinicalContextRefs": { "type": "array", "items": { "type": "string" } },
        "attachedProfiles": { "type": "array", "items": { "$ref": "#/$defs/attachedProfile" } },
        "activeInterpretationProfileRef": { "$ref": "#/$defs/versionedRef" },
        "sourceAcquisitionIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "notes": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "orthosisProject": {
      "type": "object",
      "required": ["orthosisProjectId", "caseId", "side", "status"],
      "properties": {
        "orthosisProjectId": { "$ref": "#/$defs/id" },
        "caseId": { "$ref": "#/$defs/id" },
        "side": { "$ref": "#/$defs/side" },
        "externalIdentifiers": { "type": "array", "items": { "$ref": "#/$defs/externalIdentifier" } },
        "currentDesignRevisionId": { "$ref": "#/$defs/id" },
        "status": { "type": "string", "enum": ["ACTIVE", "ARCHIVED", "CLOSED", "UNKNOWN"] }
      },
      "additionalProperties": false
    },
    "definitionHeader": {
      "type": "object",
      "required": ["id", "version", "displayName", "status", "contentHash"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string" },
        "displayName": { "type": "string" },
        "status": { "type": "string" },
        "contentHash": { "$ref": "#/$defs/hashValue" },
        "sourceRegistryUri": { "type": "string" },
        "capturedAt": { "$ref": "#/$defs/timestamp" },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "payload": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "projectDefinitions": {
      "type": "object",
      "required": ["baseTemplates", "indicationProfiles", "presetDefinitions", "materialDefinitions", "promInstrumentDefinitions", "manufacturingProfiles"],
      "properties": {
        "baseTemplates": { "type": "array", "items": { "$ref": "#/$defs/definitionHeader" } },
        "indicationProfiles": { "type": "array", "items": { "$ref": "#/$defs/definitionHeader" } },
        "presetDefinitions": { "type": "array", "items": { "$ref": "#/$defs/definitionHeader" } },
        "materialDefinitions": { "type": "array", "items": { "$ref": "#/$defs/definitionHeader" } },
        "promInstrumentDefinitions": { "type": "array", "items": { "$ref": "#/$defs/definitionHeader" } },
        "manufacturingProfiles": { "type": "array", "items": { "$ref": "#/$defs/definitionHeader" } },
        "algorithmDefinitions": { "type": "array", "items": { "$ref": "#/$defs/definitionHeader" } }
      },
      "additionalProperties": false
    },
    "assetDescriptor": {
      "type": "object",
      "required": ["assetId", "role", "mediaType", "byteLength", "hash", "storageRef", "createdAt", "availability"],
      "properties": {
        "assetId": { "$ref": "#/$defs/id" },
        "role": { "type": "string" },
        "mediaType": { "type": "string" },
        "byteLength": { "type": "integer", "minimum": 0 },
        "hash": { "$ref": "#/$defs/hashValue" },
        "originalFileName": { "type": "string" },
        "originalSourceUri": { "type": "string" },
        "storageRef": { "type": "string" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "sourceAssetIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "provenanceRecordId": { "$ref": "#/$defs/id" },
        "availability": { "type": "string", "enum": ["EMBEDDED", "LOCAL_EXTERNAL", "REMOTE_EXTERNAL", "MISSING"] }
      },
      "additionalProperties": false
    },
    "frameDefinition": {
      "type": "object",
      "required": ["frameId", "frameType", "units", "conventionVersion"],
      "properties": {
        "frameId": { "$ref": "#/$defs/id" },
        "frameType": { "type": "string" },
        "side": { "$ref": "#/$defs/side" },
        "units": { "type": "string" },
        "conventionVersion": { "type": "string" },
        "description": { "type": "string" }
      },
      "additionalProperties": false
    },
    "acquisition": {
      "type": "object",
      "required": ["acquisitionId", "acquisitionType", "caseRef", "side", "capturedAt", "importedAt", "rawAssetRefs", "units", "sourceFrameRef", "protocol", "qualityFlags", "provenanceRecordId"],
      "properties": {
        "acquisitionId": { "$ref": "#/$defs/id" },
        "acquisitionType": { "type": "string", "enum": ["PRESSURE", "SCAN_3D", "SCAN_2D", "IMAGE_2D", "REFERENCE_MESH", "BIOMECHE_RESULT"] },
        "caseRef": { "$ref": "#/$defs/id" },
        "side": { "$ref": "#/$defs/side" },
        "capturedAt": { "$ref": "#/$defs/timestamp" },
        "importedAt": { "$ref": "#/$defs/timestamp" },
        "operatorRef": { "$ref": "#/$defs/agentRef" },
        "deviceRef": { "$ref": "#/$defs/agentRef" },
        "rawAssetRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "units": { "type": "string" },
        "sourceFrameRef": { "$ref": "#/$defs/id" },
        "protocol": { "type": "object", "additionalProperties": true },
        "qualityFlags": { "type": "array", "items": { "type": "string" } },
        "provenanceRecordId": { "$ref": "#/$defs/id" },
        "payload": { "type": "object", "additionalProperties": true }
      },
      "additionalProperties": false
    },
    "registration": {
      "type": "object",
      "required": ["registrationId", "sourceFrameId", "targetFrameId", "transformType", "transformData", "method", "qualityState", "createdAt", "createdBy", "provenanceRecordId"],
      "properties": {
        "registrationId": { "$ref": "#/$defs/id" },
        "sourceFrameId": { "$ref": "#/$defs/id" },
        "targetFrameId": { "$ref": "#/$defs/id" },
        "transformType": { "type": "string", "enum": ["RIGID_3D", "SIMILARITY_3D", "AFFINE_2D", "RIGID_2D", "OTHER"] },
        "transformData": { "type": "object", "additionalProperties": true },
        "method": { "type": "string" },
        "landmarkCorrespondenceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "algorithmRef": { "$ref": "#/$defs/algorithmRef" },
        "errorMetrics": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "qualityState": { "type": "string" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "createdBy": { "$ref": "#/$defs/agentRef" },
        "provenanceRecordId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "landmarkSet": {
      "type": "object",
      "required": ["landmarkSetId", "version", "frameId", "side", "landmarks"],
      "properties": {
        "landmarkSetId": { "$ref": "#/$defs/id" },
        "version": { "type": "string" },
        "frameId": { "$ref": "#/$defs/id" },
        "side": { "$ref": "#/$defs/side" },
        "sourceAcquisitionId": { "$ref": "#/$defs/id" },
        "landmarks": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
      },
      "additionalProperties": false
    },
    "roiDefinition": {
      "type": "object",
      "required": ["roiId", "version", "displayName", "side", "roiType", "frameId"],
      "properties": {
        "roiId": { "$ref": "#/$defs/id" },
        "version": { "type": "string" },
        "displayName": { "type": "string" },
        "side": { "$ref": "#/$defs/side" },
        "roiType": { "type": "string" },
        "semanticRegion": { "type": "string" },
        "frameId": { "$ref": "#/$defs/id" },
        "geometryOrMaskAssetRef": { "$ref": "#/$defs/id" },
        "generationParameters": { "type": "object", "additionalProperties": true },
        "sourceRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "algorithmRef": { "$ref": "#/$defs/algorithmRef" },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } }
      },
      "additionalProperties": false
    },
    "designOperation": {
      "type": "object",
      "required": ["operationId", "operationType", "operationOrder", "enabled", "side", "parameters", "algorithmRef", "authorRef", "createdAt"],
      "properties": {
        "operationId": { "$ref": "#/$defs/id" },
        "operationType": { "type": "string", "enum": ["TEMPLATE_MORPH", "THICKNESS", "FLATTEN", "HEEL_CUP", "HEEL_RELIEF", "HEEL_CAMBER", "MEDIAL_ARCH", "LATERAL_ARCH", "REARFOOT_WEDGE", "FOREFOOT_WEDGE", "CORRECTIVE_ELEMENT", "OFFLOAD_FEATURE", "SCULPT", "SMOOTH", "SCAN_CONFORM", "HEIGHT_CONSTRAINT"] },
        "operationOrder": { "type": "integer", "minimum": 0 },
        "enabled": { "type": "boolean" },
        "side": { "$ref": "#/$defs/side" },
        "anatomicalRegionRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "roiRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "landmarkRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "parameters": { "type": "object", "additionalProperties": true },
        "intendedEffect": { "type": "string" },
        "sourceAcquisitionRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "sourcePresetRef": { "$ref": "#/$defs/versionedRef" },
        "algorithmRef": { "$ref": "#/$defs/algorithmRef" },
        "authorRef": { "$ref": "#/$defs/agentRef" },
        "createdAt": { "$ref": "#/$defs/timestamp" }
      },
      "additionalProperties": false
    },
    "designRevision": {
      "type": "object",
      "required": ["revisionId", "orthosisProjectId", "side", "parentRevisionIds", "createdAt", "authorRef", "authorityMode", "baseTemplateRef", "sourceAcquisitionRefs", "registrationRefs", "attachedProfileRefs", "operationStack", "materialPrescription", "derivedGeometryRefs", "designMetrics", "validationSummary", "algorithmBundleRefs", "contentHash", "provenanceRecordId"],
      "properties": {
        "revisionId": { "$ref": "#/$defs/id" },
        "orthosisProjectId": { "$ref": "#/$defs/id" },
        "side": { "$ref": "#/$defs/side" },
        "parentRevisionIds": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "authorRef": { "$ref": "#/$defs/agentRef" },
        "rationale": { "type": "string" },
        "revisionLabel": { "type": "string" },
        "authorityMode": { "type": "string", "enum": ["SEMANTIC_PARAMETRIC", "IMPORTED_LEGACY_GEOMETRY"] },
        "baseTemplateRef": { "$ref": "#/$defs/versionedRef" },
        "sourceAcquisitionRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "registrationRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "attachedProfileRefs": { "type": "array", "items": { "$ref": "#/$defs/versionedRef" } },
        "activeInterpretationProfileRef": { "$ref": "#/$defs/versionedRef" },
        "operationStack": { "type": "array", "items": { "$ref": "#/$defs/designOperation" } },
        "materialPrescription": { "type": "object", "additionalProperties": true },
        "derivedGeometryRefs": { "type": "array", "items": { "$ref": "#/$defs/id" } },
        "designMetrics": { "type": "array", "items": { "type": "object", "additionalProperties": true } },
        "validationSummary": { "type": "object", "additionalProperties": true },
        "algorithmBundleRefs": { "type": "array", "items": { "$ref": "#/$defs/algorithmRef" } },
        "contentHash": { "$ref": "#/$defs/hashValue" },
        "provenanceRecordId": { "$ref": "#/$defs/id" }
      },
      "additionalProperties": false
    },
    "outcomeTarget": {
      "type": "object",
      "required": ["targetId", "caseId", "targetType", "metric", "roiRef", "criterion", "evidenceRefs", "evidenceConfidence", "createdAt", "createdBy"],
      "properties": {
        "targetId": { "$ref": "#/$defs/id" },
        "caseId": { "$ref": "#/$defs/id" },
        "orthosisProjectId": { "$ref": "#/$defs/id" },
        "sourceProfileRef": { "$ref": "#/$defs/versionedRef" },
        "targetType": { "type": "string" },
        "metric": { "type": "string" },
        "roiRef": { "$ref": "#/$defs/id" },
        "criterion": { "type": "string" },
        "quantity": { "$ref": "#/$defs/quantity" },
        "range": { "type": "object", "additionalProperties": true },
        "acquisitionProtocolRef": { "type": "string" },
        "evidenceRefs": { "type": "array", "items": { "$ref": "#/$defs/evidenceRef" } },
        "evidenceConfidence": { "type": "string" },
        "createdAt": { "$ref": "#/$defs/timestamp" },
        "createdBy": { "$ref": "#/$defs/agentRef" },
        "copiedFromCanonicalTargetHash": { "$ref": "#/$defs/hashValue" }
      },
      "additionalProperties": false
    },
    "outcomeMeasurement": {
      "type": "object",
      "required": ["measurementId", "measurementKind", "caseId", "orthosisProjectId", "side", "designRevisionId", "metric", "units", "computationDefinition", "timestamp", "protocolRef", "qualityState", "provenanceRecordId"],
      "properties": {
        "measurementId": { "$ref": "#/$defs/id" },
        "measurementKind": { "type": "string", "enum": ["MEASURED", "PREDICTED"] },
        "caseId": { "$ref": "#/$defs/id" },
        "orthosisProjectId": { "$ref": "#/$defs/id" },
        "side": { "$ref": "#/$defs/side" },
